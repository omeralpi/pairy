{
  "name": "pairy",
  "version": "0.1.0",
  "private": true,
  "description": "Swap local cash for XLM or USDC in person, settled by a Stellar claimable balance only the two of you can open. Stellar testnet.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omeralpi/pairy.git"
  },
  "homepage": "https://pairy.org",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "predev": "pnpm copy:maplibre-worker",
    "dev": "next dev",
    "prebuild": "pnpm copy:maplibre-worker",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:testnet": "vitest run --config vitest.testnet.config.ts",
    "copy:maplibre-worker": "node -e \"require('node:fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\""
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@stellar/typescript-wallet-sdk-km": "^5.0.0",
    "@tanstack/react-query": "^5.104.2",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "next": "14.2.35",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "stellar-resolve-claimant-predicates": "^2.0.10",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@reown/appkit",
      "@stellar/stellar-sdk",
      "blake-hash",
      "bufferutil",
      "esbuild",
      "protobufjs",
      "secp256k1",
      "sodium-native",
      "tiny-secp256k1",
      "unrs-resolver",
      "usb",
      "utf-8-validate"
    ]
  }
}
