# Postgres. Local: `docker compose up -d` then use the value below.
# Production: a pooled Neon connection string.
DATABASE_URL=postgresql://pairy:pairy@localhost:35433/pairy

# Signs the session cookie: 32+ random characters, e.g. `openssl rand -base64 48`.
# Not a Stellar key. The placeholder is too short on purpose: sign-in fails
# until you set your own.
SESSION_SECRET=change-me

# Production only: Vercel Cron sends it to the daily cleanup job (32+ characters).
# CRON_SECRET=
