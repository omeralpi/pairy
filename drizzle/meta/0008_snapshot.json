      "checkConstraints": {
        "trades_seller_not_buyer": {
          "name": "trades_seller_not_buyer",
          "value": "\"trades\".\"seller\" <> \"trades\".\"buyer\""
        },
        "trades_amount_positive": {
          "name": "trades_amount_positive",
          "value": "\"trades\".\"amount\" > 0"
        },
        "trades_fiat_amount_nonnegative": {
          "name": "trades_fiat_amount_nonnegative",
          "value": "\"trades\".\"fiat_amount\" >= 0"
        },
        "trades_lock_recorded": {
          "name": "trades_lock_recorded",
          "value": "\"trades\".\"state\" NOT IN ('locked', 'claimed', 'reclaimed') OR (\"trades\".\"balance_id\" IS NOT NULL AND \"trades\".\"lock_tx\" IS NOT NULL)"
        },
        "trades_claim_recorded": {
          "name": "trades_claim_recorded",
          "value": "\"trades\".\"state\" <> 'claimed' OR \"trades\".\"claim_tx\" IS NOT NULL"
        },
        "trades_reclaim_recorded": {
          "name": "trades_reclaim_recorded",
          "value": "\"trades\".\"state\" <> 'reclaimed' OR \"trades\".\"reclaim_tx\" IS NOT NULL"
        },
        "trades_protected_usdc": {
          "name": "trades_protected_usdc",
          "value": "\"trades\".\"mode\"::text <> 'protected' OR \"trades\".\"asset\"::text = 'USDC'"
        },
        "trades_protected_terms": {
          "name": "trades_protected_terms",
          "value": "(\"trades\".\"mode\"::text = 'protected') = (\"trades\".\"acceptance_version\" IS NOT NULL)"
        },
        "trades_mode_states": {
          "name": "trades_mode_states",
          "value": "(\"trades\".\"mode\"::text = 'claimable' AND \"trades\".\"state\"::text IN ('listed', 'agreed', 'locked', 'claimed', 'reclaimed', 'cancelled')) OR (\"trades\".\"mode\"::text = 'protected' AND \"trades\".\"state\"::text IN ('listed', 'agreed', 'escrow_created', 'funded', 'released', 'resolved_buyer', 'resolved_seller', 'cancelled'))"
        },
        "trades_escrow_recorded": {
          "name": "trades_escrow_recorded",
          "value": "\"trades\".\"state\"::text NOT IN ('escrow_created', 'funded', 'released', 'resolved_buyer', 'resolved_seller') OR (\"trades\".\"escrow_contract_id\" IS NOT NULL AND \"trades\".\"create_tx\" IS NOT NULL AND \"trades\".\"escrow_admin\" IS NOT NULL)"
        },
        "trades_fund_recorded": {
          "name": "trades_fund_recorded",
          "value": "\"trades\".\"state\"::text NOT IN ('funded', 'released', 'resolved_buyer', 'resolved_seller') OR (\"trades\".\"fund_tx\" IS NOT NULL AND \"trades\".\"funded_at\" IS NOT NULL)"
        },
        "trades_release_recorded": {
          "name": "trades_release_recorded",
          "value": "\"trades\".\"state\"::text <> 'released' OR \"trades\".\"release_tx\" IS NOT NULL"
        },
        "trades_resolve_recorded": {
          "name": "trades_resolve_recorded",
          "value": "\"trades\".\"state\"::text NOT IN ('resolved_buyer', 'resolved_seller') OR (\"trades\".\"resolve_tx\" IS NOT NULL AND \"trades\".\"dispute_tx\" IS NOT NULL)"
        },
        "trades_dispute_recorded": {
          "name": "trades_dispute_recorded",
          "value": "\"trades\".\"mode\"::text <> 'protected' OR \"trades\".\"disputed\" = false OR (\"trades\".\"dispute_tx\" IS NOT NULL AND \"trades\".\"disputed_at\" IS NOT NULL AND \"trades\".\"dispute_recorded_at\" IS NOT NULL AND \"trades\".\"dispute_opened_by\" IS NOT NULL)"
        },
        "trades_protected_accepted": {
          "name": "trades_protected_accepted",
          "value": "\"trades\".\"mode\"::text <> 'protected' OR \"trades\".\"state\"::text IN ('listed', 'cancelled') OR (\"trades\".\"seller_accepted_at\" IS NOT NULL AND \"trades\".\"buyer_accepted_at\" IS NOT NULL)"
        }
